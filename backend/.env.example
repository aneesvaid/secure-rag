# ==============================================================================
# Secure RAG Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the actual .env file or real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Name and semantic version of the application
APP_NAME="Secure RAG Backend"
APP_VERSION=0.1.0

# Environment mode: development | testing | production
# NOTE: Production mode enforces strict validation: rejects debug mode,
# rejects default/short secret keys, and requires API keys for cloud services.
APP_ENV=development

# Enable debug mode (MUST be false in production)
DEBUG=true

# Server binding host and port
HOST=0.0.0.0
PORT=8000

# Prefix for version 1 API endpoints
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. CORS & Network Security Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of permitted frontend origins
CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://127.0.0.1:8443,http://127.0.0.1:5173

# Whether to allow credentials (cookies, authorization headers) with CORS
CORS_ALLOW_CREDENTIALS=true

# Allowed Host headers (used for HTTP host header attack prevention)
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# 3. Security & Cryptography Configuration
# ------------------------------------------------------------------------------
# Application secret key for signing tokens and security operations
# Generate a strong production key with: openssl rand -hex 32
# Production requires a non-default key with at least 32 characters.
SECRET_KEY=change-this-in-production-use-a-secure-random-key-min-32-chars

# JWT cryptographic algorithm (e.g. HS256, HS384, HS512, RS256)
JWT_ALGORITHM=HS256

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing configuration (bcrypt or argon2)
PASSWORD_HASH_ALGORITHM=bcrypt
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. Centralized Logging Configuration
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Emit structured JSON logs (automatically true in production)
LOG_JSON=false

# Optional custom standard log format
# LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s:%(funcName)s:%(lineno)d - %(message)s"

# ------------------------------------------------------------------------------
# 5. Vector Database (Qdrant) Configuration
# ------------------------------------------------------------------------------
# Full Qdrant URL (supports local: http://localhost:6333 or cloud: https://xyz.qdrant.tech:6333)
QDRANT_URL=http://localhost:6333

# Optional individual host/port overrides (if QDRANT_URL is not set)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# API key for Qdrant Cloud or secured instances (required in production for remote Qdrant)
QDRANT_API_KEY=

# Explicit override: true if remote/cloud, false if local sidecar.
# If omitted or left commented, endpoint classification automatically detects remote vs local loopback.
# QDRANT_REMOTE=false

# Collection name for vectorized document chunks
QDRANT_COLLECTION=secure_rag_documents

# Client timeout in seconds
QDRANT_TIMEOUT=10.0

# Prefer gRPC transport over HTTP REST
QDRANT_PREFER_GRPC=false

# ------------------------------------------------------------------------------
# 6. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active LLM provider: "openai" | "anthropic" | "ollama" | "vllm" | "local" | "custom"
LLM_PROVIDER=openai

# Model identifier (e.g., gpt-4o-mini, claude-3-5-sonnet-20241022, llama3.2:latest)
LLM_MODEL=gpt-4o-mini

# API key for cloud LLM provider (required in production when cloud provider is active)
LLM_API_KEY=

# Optional custom base URL for cloud or OpenAI-compatible proxy endpoints
# LLM_BASE_URL=https://api.openai.com/v1

# Base URL for locally hosted inference engines (Ollama, vLLM, LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Request timeout in seconds
LLM_TIMEOUT=60.0

# Retry attempts for transient LLM provider failures
LLM_MAX_RETRIES=3

# Generation sampling temperature (0.0 = deterministic, 1.0+ = creative)
LLM_TEMPERATURE=0.0

# Maximum response generation tokens
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 7. Embedding Model Configuration
# ------------------------------------------------------------------------------
# Active embedding provider: "openai" | "local" | "custom"
EMBEDDING_PROVIDER=openai

# Embedding model identifier (e.g. text-embedding-3-small, bge-m3, all-MiniLM-L6-v2)
EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensionality (must match model output, e.g. 1536 for text-embedding-3-small)
EMBEDDING_DIMENSION=1536

# API key for embedding service (if different from LLM_API_KEY)
EMBEDDING_API_KEY=

# Base URL for local embedding models
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1

# Embedding request timeout in seconds
EMBEDDING_TIMEOUT=30.0
